
# 0x00 0x00 : ScriptInit(0, 0, 0, 0, 0)
            0x01 0x00 0x00 0x00 0x00 0x00

# 0x06 0x00 : TriggerParseReg(0x06, 3, 1)
            0x02 0x06 0x03 0x01

# 0x0A 0x00 : IfRegValGeq(0x06, 2000, 0x21 0x00)
            0x1A 0x06 0xD0 0x07 0x00 0x00 0x21 0x00

# 0x12 0x00 : SetRegVal(0x07, 0xFF)
            0x30 0x07 0xFF 0x00 0x00 0x00

# 0x18 0x00 : CanSendRegVal11(0x0165, 0x01, 1, 0x07, 0x0E, {op6:dec})
            0xA1 0x65 0x01 0x01 0x01 0x07 0x0E {op6}

# 0x20 0x00 : Exit()
            0x82

# 0x21 0x00 : IfRegValLeq(0x06, 1000, 0x2F 0x00)
            0x16 0x06 0xE8 0x03 0x00 0x00 0x2F 0x00

# 0x29 0x00 : SetRegVal(0x07, 0x00)
            0x30 0x07 0x00 0x00 0x00 0x00

# 0x2F 0x00 : Exit()
            0x82
